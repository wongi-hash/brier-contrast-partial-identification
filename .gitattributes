# Normalize line endings so SHA-256 checksums are stable across platforms.
# All text is stored and checked out as LF; this makes the committed
# SHA256SUMS.txt / MANIFEST hashes reproducible on Windows checkouts.
* text=auto eol=lf

# Treat data/result artifacts as binary (never line-ending converted).
*.csv binary
*.json binary
*.zip binary
*.pdf binary
*.png binary
*.tif binary
*.tiff binary
*.eps binary
